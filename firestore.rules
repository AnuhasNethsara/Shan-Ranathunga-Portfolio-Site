rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public read access for site data (hero, about, contactInfo, settings, admins)
    match /siteData/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public read for portfolio, services, testimonials
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /services/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Messages - only authenticated users can read/write
    match /messages/{docId} {
      allow read, write: if request.auth != null;
    }

    // Proposals - only authenticated users can read/write
    match /proposals/{docId} {
      allow read, write: if request.auth != null;
    }

    // Chats - only authenticated users can read/write (real-time)
    match /chats/{docId} {
      allow read, write: if request.auth != null;
    }

    // User profiles - authenticated users can read all, write their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
